# Sectrix — production environment for the droplet.
# Copy to /opt/sectrix/.env and fill in. docker compose reads it automatically.
#
# Generate the secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# ---- Django core ---------------------------------------------------------
DJANGO_SECRET_KEY=REPLACE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=sectrix.com,www.sectrix.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sectrix.com,https://www.sectrix.com
DJANGO_TIME_ZONE=Asia/Dubai
SITE_URL=https://sectrix.com

# ---- Demo content --------------------------------------------------------
# true  = entrypoint re-seeds demo services/case studies/jobs on every start.
# Flip to false once real content is entered, or admin edits get reverted.
SECTRIX_SEED_DEMO=true

# ---- Search indexing -----------------------------------------------------
# Keep False while demo content is live: robots.txt disallows everything and
# pages carry <meta name="robots" content="noindex, nofollow">.
# Flip to True when real content ships.
DJANGO_ALLOW_INDEXING=False

# ---- Database ------------------------------------------------------------
POSTGRES_DB=sectrix
POSTGRES_USER=sectrix
POSTGRES_PASSWORD=REPLACE_ME

# ---- Email (contact form) ------------------------------------------------
# Left on the console backend, inquiries are stored in the DB but never
# emailed. Fill in real SMTP before you rely on the contact form.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@sectrix.com
CONTACT_INBOX=contact@sectrix.com
