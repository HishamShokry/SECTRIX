# Sectrex — production environment for the droplet.
# Copy to /opt/sectrix/.env and fill in. docker compose reads it automatically.
#
# Generate the secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# ---- Django core ---------------------------------------------------------
DJANGO_SECRET_KEY=REPLACE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=sectrexconsulting.com,www.sectrexconsulting.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sectrexconsulting.com,https://www.sectrexconsulting.com
DJANGO_TIME_ZONE=Asia/Dubai
SITE_URL=https://sectrexconsulting.com

# Required when nginx terminates TLS in front of the app: without it Django
# cannot tell HTTP from HTTPS, so SECURE_SSL_REDIRECT stays off and secure
# cookies are not enforced. Only set it if the app is NOT also reachable
# directly, or a client can forge X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=True

# Address the app container publishes on. Leave as loopback when nginx runs on
# the same machine. When nginx runs on an LXC/VM *host* and the app runs inside
# a guest, set this to the guest's private bridge address (the one nginx
# proxy_passes to) -- loopback is a different network namespace and the proxy
# would get connection-refused.
APP_BIND_IP=127.0.0.1

# ---- Demo content --------------------------------------------------------
# true  = entrypoint re-seeds demo services/case studies/jobs on every start.
# Flip to false once real content is entered, or admin edits get reverted.
SECTRIX_SEED_DEMO=true

# ---- Search indexing -----------------------------------------------------
# Keep False while demo content is live: robots.txt disallows everything and
# pages carry <meta name="robots" content="noindex, nofollow">.
# Flip to True when real content ships.
DJANGO_ALLOW_INDEXING=False

# ---- Gunicorn ------------------------------------------------------------
# Roughly (2 x cores) + 1. Past ~8 workers this site gains nothing.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# ---- Deployment checks ---------------------------------------------------
# Config problems (console email backend, placeholder secret key) are reported
# as warnings by default so a slip cannot take the site down. Flip to True once
# the deployment has settled and you want a bad config to block the boot.
DJANGO_STRICT_DEPLOY_CHECKS=False

# ---- Admin brute-force protection ---------------------------------------
DJANGO_AXES_FAILURE_LIMIT=5
DJANGO_AXES_COOLOFF_HOURS=1

# ---- Data retention ------------------------------------------------------
# Enforced by: python manage.py purge_inquiries   (schedule it; nothing
# expires on its own)
DJANGO_INQUIRY_RETENTION_DAYS=730

# ---- Logging -------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
# Comma-separated "Name:email" pairs to receive unhandled-exception reports.
DJANGO_ADMINS=

# ---- Database ------------------------------------------------------------
POSTGRES_DB=sectrix
POSTGRES_USER=sectrix
POSTGRES_PASSWORD=REPLACE_ME

# ---- Email (contact form) ------------------------------------------------
# The console backend prints the full inquiry -- name, work email, phone and
# the free-text body -- to stdout, which Docker persists to disk outside the
# database's access controls. apps/core/checks.py warns about it on every
# start (and blocks it under DJANGO_STRICT_DEPLOY_CHECKS). Use a real relay.
# Note: many hosts block outbound 25; use 587 and confirm it is open.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@sectrexconsulting.com
CONTACT_INBOX=contact@sectrexconsulting.com
