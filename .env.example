# ---- Django core ---------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=True
# Set True only when a TLS-terminating proxy fronts the app.
DJANGO_BEHIND_PROXY=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Dubai

# ---- Database (PostgreSQL in production) --------------------------------
# Leave DJANGO_DB_ENGINE unset (or =sqlite) for the default SQLite dev DB.
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=sectrix
POSTGRES_USER=sectrix
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Email (contact form) ------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@sectrexconsulting.com
CONTACT_INBOX=contact@sectrexconsulting.com

# ---- Public site URL ----------------------------------------------------
SITE_URL=https://sectrexconsulting.com
